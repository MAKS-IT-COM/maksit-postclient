<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MaksIT.PostClient.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MaksIT.PostClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="MaksIT.Core" Version="1.6.14" />
    <PackageReference Include="MaksIT.IdentityHub.Client" Version="3.1.3" />
    <PackageReference Include="MaksIT.Results" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="OfficeIMO.Email" Version="3.5.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageReference Include="XstReader.Api" Version="1.0.6" />
  </ItemGroup>

  <PropertyGroup>
    <OnnxUseDirectML Condition="$([MSBuild]::IsOSPlatform('Windows')) AND ('$(RuntimeIdentifier)' == '' OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')))">true</OnnxUseDirectML>
  </PropertyGroup>

  <ItemGroup Condition="'$(OnnxUseDirectML)' == 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(OnnxUseDirectML)' != 'true'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaksIT.PostClient.Shared\MaksIT.PostClient.Shared.csproj" />
  </ItemGroup>

</Project>
