<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaksIT.PostClient.UI.Windows.PromptWindow"
        Icon="/Assets/icon.ico"
        Width="420"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="OkButton" Classes="mail-tool" Click="OnOkClick" IsDefault="True" />
      <Button x:Name="CancelButton" Classes="mail-tool" Click="OnCancelClick" IsCancel="True" />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
      <TextBox x:Name="ValueBox" TextChanged="OnValueChanged" />
      <TextBlock x:Name="RepeatLabel" Classes="hint" IsVisible="False" />
      <TextBox x:Name="RepeatBox" PasswordChar="●" IsVisible="False" TextChanged="OnValueChanged" />
      <TextBlock x:Name="ErrorText" Classes="unresolved" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>
  </DockPanel>
</Window>
