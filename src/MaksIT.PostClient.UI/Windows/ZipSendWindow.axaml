<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.PostClient.UI.ViewModels"
        x:Class="MaksIT.PostClient.UI.Windows.ZipSendWindow"
        x:DataType="vm:ZipSendRequest"
        Icon="/Assets/icon.ico"
        Width="440"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button x:Name="OkButton" Classes="mail-tool" Click="OnOkClick" IsDefault="True" />
      <Button x:Name="CancelButton" Classes="mail-tool" Click="OnCancelClick" IsCancel="True" />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock x:Name="HintText" TextWrapping="Wrap" Classes="hint" />
      <TextBlock x:Name="NameLabel" Classes="hint" />
      <TextBox x:Name="NameBox" Text="{Binding FileName}" />
      <TextBlock x:Name="PasswordLabel" Classes="hint" />
      <TextBox x:Name="PasswordBox"
               Text="{Binding Password}"
               PasswordChar="•" />
    </StackPanel>
  </DockPanel>
</Window>
