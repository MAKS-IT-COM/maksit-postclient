<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaksIT.PostClient.UI.ViewModels"
        x:Class="MaksIT.PostClient.UI.Windows.RetentionWindow"
        x:Name="Root"
        x:DataType="vm:RetentionViewModel"
        Title="{Binding Copy.Retention}"
        Icon="/Assets/icon.ico"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16" LastChildFill="True">
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Copy.RetentionHint}"
               Classes="hint"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Content="{Binding Copy.RetentionRun}"
              Classes="mail-tool"
              Command="{Binding RunCommand}" />
      <Button Content="{Binding Copy.Close}" Classes="quiet" Click="OnCloseClick" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Rows}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{Binding Copy.Mailbox, ElementName=Root}"
                            Binding="{Binding MailboxLabel}"
                            IsReadOnly="True"
                            Width="*" />
        <DataGridTextColumn Header="{Binding Copy.Folders, ElementName=Root}"
                            Binding="{Binding Folder}"
                            IsReadOnly="True"
                            Width="*" />
        <DataGridTextColumn Header="{Binding Copy.RetentionAction, ElementName=Root}"
                            Binding="{Binding ActionLabel}"
                            IsReadOnly="True"
                            Width="140" />
        <DataGridTextColumn Header="{Binding Copy.RetentionDays, ElementName=Root}"
                            Binding="{Binding Days}"
                            Width="90" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
