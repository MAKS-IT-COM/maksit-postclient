<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="using:MaksIT.PostClient.UI.Layout"
             xmlns:views="using:MaksIT.PostClient.UI.Views.Mail"
             x:Class="MaksIT.PostClient.UI.Views.Mail.MailShellView">
  <Grid layout:LayoutMemento.PersistMail="True"
        ColumnDefinitions="248,4,*"
        RowDefinitions="*,4,1.15*">
    <views:FolderPaneView Grid.Column="0"
                          Grid.Row="0"
                          Grid.RowSpan="3" />
    <GridSplitter Grid.Column="1"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Width="4"
                  Background="#2a2e33"
                  ResizeDirection="Columns"
                  layout:LayoutMemento.PaneRole="FolderSplitter" />
    <views:MessageListView Grid.Column="2"
                           Grid.Row="0" />
    <GridSplitter Grid.Column="2"
                  Grid.Row="1"
                  Height="4"
                  Background="#2a2e33"
                  ResizeDirection="Rows"
                  layout:LayoutMemento.PaneRole="StackedSplitter" />
    <GridSplitter Grid.Column="3"
                  Grid.Row="0"
                  Width="4"
                  Background="#2a2e33"
                  ResizeDirection="Columns"
                  IsVisible="False"
                  layout:LayoutMemento.PaneRole="WideSplitter" />
    <views:ReadingPaneView Grid.Column="2"
                           Grid.Row="2" />
  </Grid>
</UserControl>
