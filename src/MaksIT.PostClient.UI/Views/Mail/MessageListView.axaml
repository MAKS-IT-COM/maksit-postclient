<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layout="using:MaksIT.PostClient.UI.Layout"
             xmlns:mail="using:MaksIT.PostClient.Shared.Mail"
             xmlns:vm="using:MaksIT.PostClient.UI.ViewModels"
             x:Class="MaksIT.PostClient.UI.Views.Mail.MessageListView"
             x:DataType="vm:MainViewModel"
             MinWidth="220"
             layout:LayoutMemento.PaneRole="List"
             layout:LayoutMemento.ListPane="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="quick-filter">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="8,0,0,0">
          <TextBox Width="160"
                   PlaceholderText="Condominio X"
                   Text="{Binding PracticeLabel}" />
          <Button Content="{Binding Copy.Label}"
                  Classes="mail-tool"
                  Command="{Binding ApplyPracticeLabelCommand}"
                  ToolTip.Tip="{Binding Copy.LabelTip}" />
        </StackPanel>
        <TextBox PlaceholderText="{Binding Copy.SearchPlaceholder}"
                 Text="{Binding MessageFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 layout:LayoutMemento.PersistFilter="True">
          <TextBox.InnerRightContent>
            <Button Classes="search-clear"
                    Content="×"
                    Command="{Binding ClearMessageFilterCommand}"
                    IsVisible="{Binding HasMessageFilter}"
                    ToolTip.Tip="{Binding Copy.ClearSearch}" />
          </TextBox.InnerRightContent>
        </TextBox>
      </DockPanel>
    </Border>
    <DataGrid x:Name="MessagesGrid"
              ItemsSource="{Binding VisibleMessages}"
              SelectionMode="Extended"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserResizeColumns="True"
              CanUserSortColumns="True"
              CanUserReorderColumns="True"
              HeadersVisibility="Column"
              RowHeight="26"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto"
              layout:LayoutMemento.Table="{x:Static mail:LayoutSettings.MessagesTable}"
              SelectionChanged="OnSelectionChanged"
              ContextRequested="OnContextRequested"
              DoubleTapped="OnDoubleTapped">
      <DataGrid.ContextFlyout>
        <MenuFlyout Opening="OnMenuOpening">
          <MenuItem Header="{Binding Copy.Reply}" Command="{Binding ReplyCommand}" />
          <MenuItem Header="{Binding Copy.ReplyAll}" Command="{Binding ReplyAllCommand}" />
          <MenuItem Header="{Binding Copy.Forward}" Command="{Binding ForwardCommand}" />
          <MenuItem Header="{Binding Copy.OpenInNewWindow}" Command="{Binding OpenMessageWindowCommand}" />
          <Separator />
          <MenuItem Header="{Binding Copy.MarkRead}" Command="{Binding MarkReadCommand}" />
          <MenuItem Header="{Binding Copy.MarkUnread}" Command="{Binding MarkUnreadCommand}" />
          <MenuItem Header="{Binding Copy.FlagToggle}" Command="{Binding ToggleFlagCommand}" />
          <MenuItem Header="{Binding Copy.MarkSpam}" Command="{Binding MarkSpamCommand}" />
          <MenuItem Header="{Binding Copy.MarkNotSpam}" Command="{Binding MarkNotSpamCommand}" />
          <MenuItem Header="{Binding Copy.Priority}">
            <MenuItem Header="{Binding Copy.PriorityHigh}" Command="{Binding SetPriorityCommand}" CommandParameter="high" />
            <MenuItem Header="{Binding Copy.PriorityNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="normal" />
            <MenuItem Header="{Binding Copy.PriorityLow}" Command="{Binding SetPriorityCommand}" CommandParameter="low" />
          </MenuItem>
          <Separator />
          <MenuItem Header="{Binding Copy.MoveTo}" />
          <MenuItem Header="{Binding Copy.Delete}" Command="{Binding DeleteMessagesCommand}" />
        </MenuFlyout>
      </DataGrid.ContextFlyout>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="●" Tag="Unread" Width="22" MinWidth="22" CanUserSort="True" SortMemberPath="UnreadSort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding UnreadTip}">
                <TextBlock Text="{Binding UnreadMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="⚠" Tag="Spam" Width="28" MinWidth="28" CanUserSort="True" SortMemberPath="SpamSort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding SpamTip}">
                <TextBlock Text="{Binding SpamMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="?" Tag="SpamHint" Width="22" MinWidth="22">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding SpamHint}">
                <TextBlock Text="{Binding SpamHintMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="10" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="★" Tag="Flag" Width="28" MinWidth="28" CanUserSort="True" SortMemberPath="FlagSort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="{Binding FlagMark}"
                      Classes="flag-cell"
                      ToolTip.Tip="{Binding FlagTip}"
                      Click="OnToggleFlagClick" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="!" Tag="Priority" Width="22" MinWidth="22" CanUserSort="True" SortMemberPath="PrioritySort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding PriorityTip}">
                <TextBlock Text="{Binding PriorityMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="📎" Tag="Attachments" Width="28" MinWidth="28" CanUserSort="True" SortMemberPath="AttachmentSort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding AttachmentTip}">
                <TextBlock Text="{Binding AttachmentMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="✓" Tag="Delivery" Width="32" MinWidth="32" CanUserSort="True" SortMemberPath="DeliverySort">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding DeliveryTip}">
                <TextBlock Text="{Binding DeliveryMark}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Type" Tag="Type" Width="48" MinWidth="44" CanUserSort="True" SortMemberPath="Badge">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Classes="cell-tip" ToolTip.Tip="{Binding BadgeTip}">
                <TextBlock Text="{Binding Badge}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="From" Tag="From" Width="170" MinWidth="80" SortMemberPath="From">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding From}"
                         FontWeight="{Binding Weight}"
                         TextTrimming="CharacterEllipsis"
                         Margin="6,0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Label" Tag="Label" Width="120" MinWidth="60" SortMemberPath="Labels">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Labels}"
                         TextTrimming="CharacterEllipsis"
                         Margin="6,0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Subject" Tag="Subject" Width="280" MinWidth="120" SortMemberPath="Subject">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding ChainSubject}"
                         FontWeight="{Binding Weight}"
                         TextTrimming="CharacterEllipsis"
                         Margin="{Binding SubjectPad}"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Date" Tag="Date" Binding="{Binding When}" Width="132" MinWidth="110" SortMemberPath="SortDate" />
        <DataGridTemplateColumn Header="Size" Tag="Size" Width="80" MinWidth="64" CanUserSort="True" SortMemberPath="Size">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SizeLine}"
                         HorizontalAlignment="Right"
                         Margin="6,0"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
