<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MaksIT.PostClient.UI.App"
             Name="Postclient"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />
    <StyleInclude Source="avares://MaksIT.PostClient.UI/Themes/Dark.axaml" />
  </Application.Styles>
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/icon.ico"
                ToolTipText="Postclient"
                Clicked="OnTrayClicked">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Open Postclient" Click="OnTrayOpenClick" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Exit" Click="OnTrayExitClick" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
